{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ootb-ai-game-runner-cfw",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSIONS",
        "class_name": "GameSession"
      }
    ]
  },
  "exports": {
    "GameSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
